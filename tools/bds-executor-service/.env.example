# Backend thực thi: playwright (thật) | mock (smoke-test, không mở trình duyệt).
EXECUTOR_BACKEND=playwright

# Cổng service (pipeline trỏ OPENCLAW_RUN_URL=http://127.0.0.1:5678/webhook/bds-action vào đây)
PORT=5678

# Token bảo vệ endpoint (phải khớp OPENCLAW_TOKEN phía pipeline). Bỏ trống = không kiểm.
BDS_EXECUTOR_TOKEN=

# Thư mục lưu profile trình duyệt bền theo account (cookies/login). Mỗi account 1 thư mục con.
PROFILES_DIR=./profiles

# headless=false + Xvfb trên VPS để giống người thật hơn. Mặc định headful.
HEADLESS=false

# Proxy theo account dạng JSON: {"zalo_acc01":"http://user:pass@host:port"}. Bỏ trống nếu không dùng.
ACCOUNT_PROXIES={}

# Locale + timezone giả lập (giống người dùng VN).
BROWSER_LOCALE=vi-VN
BROWSER_TIMEZONE=Asia/Ho_Chi_Minh

# Thư mục dump screenshot + HTML khi inspect / khi 1 bước không tìm thấy selector.
DEBUG_DIR=./debug
