# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Model lọc/phân loại (lặp, khối lượng lớn) -> dùng Haiku cho rẻ.
# LƯU Ý: model khả dụng tùy tài khoản. Kiểm tra bằng GET https://api.anthropic.com/v1/models
# Ví dụ thế hệ hiện hành: claude-haiku-4-5-20251001 (rẻ), claude-sonnet-4-5 / claude-sonnet-4-6 (văn phong).
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Bật/tắt gọi Claude. false = chỉ dùng chuẩn hóa + chấm điểm offline (tiết kiệm token khi test).
USE_CLAUDE=true

# Ngưỡng giữ Lead (0-100). Lead có score thấp hơn sẽ bị loại khỏi CLEAN.
LEAD_SCORE_MIN=50

# ===== P2: Tầng tri thức (RAG) =====
# Embedding: Voyage AI
VOYAGE_API_KEY=pa-xxxxx
# voyage-3.5 (1024 chiều) cho tiếng Việt tốt hơn hẳn voyage-3-lite (512). Khuyến nghị voyage-3.5.
VOYAGE_MODEL=voyage-3.5
# Đặt mock để test plumbing không tốn tiền (sinh vector giả, tất định).
EMBEDDING_PROVIDER=voyage

# Vector DB: Qdrant (Windows nên dùng 127.0.0.1 thay vì localhost để tránh lỗi IPv6)
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=   # bỏ trống nếu chạy local không bảo mật

# ===== P3: Advisor (tư vấn nhân bản) =====
# Model soạn câu trả lời tự nhiên (nên dùng Sonnet cho văn phong; Haiku rẻ hơn nhưng kém tự nhiên).
CLAUDE_MODEL_WRITER=claude-sonnet-4-5
# Đường dẫn file persona (nhân cách + lằn ranh đỏ + kịch bản).
PERSONA_PATH=./assets/persona.json
# Số chunk tri thức lấy cho mỗi câu trả lời.
RAG_TOP_K=4

# ===== Google Sheets API (dùng cho --source sheets ở mọi CLI) =====
# Đường dẫn file service account JSON (tạo trên Google Cloud, share Sheet cho email service account)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# ID của Google Sheet vận hành WORKFLOW_BDS_OPS. Các tab dùng tới:
#   RAW, CLEAN, QUEUE_TODAY, CONFIG, OUTREACH_QUEUE, FB_POSTS_QUEUE, CONVERSATIONS, CRM
#   + tab kết quả (tự tạo khi ghi): ZALO_CHECK_RESULTS, OUTREACH_RESULTS, FB_COMMENT_RESULTS
# Mọi CLI dùng chung sheet này; thêm cờ --source sheets để đọc/ghi tab thay vì file CSV.
OPS_SHEET_ID=

# ===== P4–P6: Thực thi qua OpenClaw =====
# mock  = chạy giả lập (test logic, không chạm Zalo/FB thật).
# openclaw = gọi OpenClaw thật để thực thi hành động trình duyệt.
# Có thể override theo từng lần chạy bằng cờ CLI: --executor openclaw
EXECUTOR_MODE=mock
# Endpoint nhận 1 hành động và trả JSON {status,data,message}.
# Khuyến nghị trỏ vào n8n webhook (điều phối tập trung) thay vì gọi thẳng gateway.
# Ví dụ n8n: http://127.0.0.1:5678/webhook/bds-action
OPENCLAW_RUN_URL=http://127.0.0.1:5678/webhook/bds-action
# Bearer token bảo vệ webhook (nếu có).
OPENCLAW_TOKEN=
# Timeout cho 1 hành động trình duyệt (ms). Hành động Zalo/FB có thể chậm.
OPENCLAW_TIMEOUT_MS=120000

